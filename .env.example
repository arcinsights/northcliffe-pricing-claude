# Smart Pricing - Environment Variables
# Copy this to .env and fill in your values

# Apify API Token (get from https://console.apify.com/account/integrations)
APIFY_API_TOKEN=

# Your Airbnb listing URL (for automatic property extraction)
AIRBNB_LISTING_URL=

# Optional: Your Booking.com listing URL (for Phase 4)
BOOKING_LISTING_URL=

# GCP Configuration (filled during setup)
GCP_PROJECT_ID=
GCP_REGION=europe-west2

# Optional: Email for alerts (future feature)
ALERT_EMAIL=
